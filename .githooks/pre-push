"""git pre-push hook: refuse to update a branch that has an open PR unless the
pushed commits match its review marker (utils/review-marker.py as of origin/main),
and refuse any branch push whose commit fails the copyright or CLAUDE.md check.
A push to a branch with an open PR that passes those gates warns to re-verify the
PR description against the pushed commits."""

import subprocess
import sys

HEADS = "refs/heads/"
TRUSTED_REF = "refs/remotes/origin/main"  # qualified: a tag named origin/main must not win


def has_open_pr(branch):
    # Fails open: without gh, network or auth the push is not gated.
    try:
        res = subprocess.run(["gh", "pr", "list", "--head", branch, "--state", "open",
                              "--json", "number", "-q", "length"],
                             stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return False
    return res.returncode == 0 and res.stdout.decode().strip() not in ("", "0")


def marker_branch(local_ref, remote_branch):
    """Branch whose marker covers the push: the local branch, the checked-out one for
    `git push origin HEAD`, else the remote name (`git push origin <sha>:<branch>`)."""
    if local_ref.startswith(HEADS):
        return local_ref[len(HEADS):]
    if local_ref == "HEAD":
        res = subprocess.run(["git", "symbolic-ref", "--quiet", "HEAD"],
                             stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        if res.returncode == 0:  # full ref: --short yields "heads/<b>" beside a same-named tag
            return res.stdout.decode().strip()[len(HEADS):]
    return remote_branch


def trusted_source(path):
    """`path` as of TRUSTED_REF, or None: checked-out files may come from an untrusted
    branch, and git hooks must not run them."""
    res = subprocess.run(["git", "show", "%s:%s" % (TRUSTED_REF, path)],
                         stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    return res.stdout.decode() if res.returncode == 0 else None


def git_lines(*args):
    res = subprocess.run(["git", *args], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    return res.stdout.decode().split() if res.returncode == 0 else None


def copyright_base(branch, local_sha):
    """(base, how to change it) for the copyright check, as CI compares the PR: the branch's
    `gh-merge-base` if fetched, else whichever of origin/main and origin/release/* the
    commit's first-parent chain adds the fewest commits to; main on a tie."""
    hint = "set branch.%s.gh-merge-base to change" % branch
    configured = git_lines("config", "--get", "branch.%s.gh-merge-base" % branch)
    if configured:
        name = configured[0] if configured[0].startswith("origin/") else "origin/" + configured[0]
        if git_lines("rev-parse", "--verify", "--quiet", "refs/remotes/%s^{commit}" % name):
            return name, "from branch.%s.gh-merge-base" % branch
        hint = "gh-merge-base %s is not fetched; fetch it to use it" % name
    # First parent: a backport off release/X is closest to X, while a branch off main that
    # merges release/X is still closest to main.
    best, best_count = "origin/main", None
    for ref in [TRUSTED_REF] + (git_lines("for-each-ref", "--format=%(refname)",
                                          "refs/remotes/origin/release/*") or []):
        count = git_lines("rev-list", "--count", "--first-parent", "%s..%s" % (ref, local_sha))
        if count and (best_count is None or int(count[0]) < best_count):
            best, best_count = ref[len("refs/remotes/"):], int(count[0])
    return best, hint


def source_checks_pass(branch, local_sha):
    """Run the CI source checks that are cheap enough for every push on the pushed commit;
    False when one reports violations. Checks not on TRUSTED_REF yet are skipped."""
    ok = True
    for script in ("check-copyright.py", "check-claude-md.py"):
        source = trusted_source("utils/" + script)
        if source is None:
            continue
        extra, label = [], script
        if script == "check-copyright.py":
            base, hint = copyright_base(branch, local_sha)
            extra = ["--base", base]
            label = "%s against %s (%s)" % (script, base, hint)
        res = subprocess.run([sys.executable, "-I", "-c", source, "--root", ".", "--head",
                              local_sha, *extra], stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        if res.returncode == 1:
            print("pre-push: %s:\n%s" % (label, res.stdout.decode(errors="replace").strip()),
                  file=sys.stderr)
            ok = False
        elif res.returncode != 0:  # environment error: CI still runs the check
            print("pre-push: %s skipped: %s" % (label, res.stdout.decode(errors="replace").strip()),
                  file=sys.stderr)
    return ok


def main():
    source = trusted_source("utils/review-marker.py")
    if source is None:
        sys.stdin.read()
        return 0  # the gate is not on the default branch yet
    blocked = False
    warnings = []
    for line in sys.stdin:
        parts = line.split()
        if len(parts) != 4:
            continue
        local_ref, local_sha, remote_ref, remote_sha = parts
        if set(local_sha) == {"0"} or not remote_ref.startswith(HEADS):
            continue  # deletions (all-zero id, SHA-1 or SHA-256) and tags are not gated
        remote_branch = remote_ref[len(HEADS):]
        branch = marker_branch(local_ref, remote_branch)
        if not source_checks_pass(branch, local_sha):
            print("pre-push: fix the files above (CI runs the same checks), then push again.",
                  file=sys.stderr)
            blocked = True
            continue
        res = subprocess.run([sys.executable, "-I", "-c", source, "check", "--branch", branch,
                              "--commit", local_sha], stdout=subprocess.PIPE,
                             stderr=subprocess.PIPE)
        # The open-PR probe runs even for a fresh marker: it also drives the description
        # warning below. Fails open (no warning, no block) like every gh call here. A
        # remote ref still at the all-zero id is being created by this push and cannot
        # have an open PR.
        open_pr = False if set(remote_sha) == {"0"} else has_open_pr(remote_branch)
        if res.returncode != 0 and open_pr:
            reason = res.stderr.decode(errors="replace").strip()
            if res.returncode == 1:
                print("pre-push: %s has an open PR and %s.\nRun the pre-pr-review skill "
                      "(.agents/skills/pre-pr-review), then push again." % (remote_branch, reason),
                      file=sys.stderr)
            else:
                print("pre-push: cannot check the review marker of %s: %s\nFix that, or "
                      "after a manual review push with --no-verify." % (branch, reason),
                      file=sys.stderr)
            blocked = True
        elif open_pr:
            # Deferred: a warning on one ref is noise when another ref blocks the push
            # and nothing lands; it prints only when the push goes through.
            warnings.append("pre-push: %s has an open PR; re-verify its title and description "
                            "against the pushed commits (pr-writing skill)." % remote_branch)
    if not blocked:
        for warning in warnings:
            print(warning, file=sys.stderr)
    return 1 if blocked else 0


if __name__ == "__main__":
    sys.exit(main())
