ARG BASE_IMAGE=eclipse-temurin:21-jdk-alpine@sha256:c98f0d2e171c898bf896dc4166815d28a56d428e218190a1f35cdc7d82efd61f
FROM ${BASE_IMAGE} as base
ARG CI_JOB_TOKEN
WORKDIR /root

RUN apk upgrade --no-cache ca-certificates ca-certificates-bundle
RUN apk update && apk add curl git moreutils aws-cli docker-credential-ecr-login gnupg alpine-sdk build-base wget npm hexdump linux-headers clang compiler-rt bash jq zip unzip \
 && ln -sf /etc/ssl/certs/ca-certificates.crt /usr/lib/python3.12/site-packages/awscli/botocore/cacert.pem
# The JDK comes from BASE_IMAGE; remove the two distrusted anchors from its cacerts.
RUN keytool -list -v -cacerts -storepass changeit | awk -F ': ' \
    '/^Alias name:/{alias=$2} /Owner:.*(emSign ECC Root CA - G3|AAA Certificate Services)/{print alias}' \
    | while IFS= read -r alias; do keytool -delete -cacerts -storepass changeit -alias "$alias"; done
RUN npm install -g --save-dev @datadog/datadog-ci
